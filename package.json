{
  "name": "keel-sdd",
  "version": "0.4.0",
  "description": "Spec-driven development for any AI coding agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrvinngB/keel.git"
  },
  "homepage": "https://github.com/IrvinngB/keel#readme",
  "bugs": {
    "url": "https://github.com/IrvinngB/keel/issues"
  },
  "keywords": [
    "spec-driven-development",
    "sdd",
