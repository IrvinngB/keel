#!/usr/bin/env node
'use strict';
// Keel CLI (`sdd`) — build adapters, install them, inspect pipeline state. Zero deps.

const fs = require('fs');
const path = require('path');
const cp = require('child_process');

const ROOT = path.resolve(__dirname, '..');
const args = process.argv.slice(2);
const cmd = args[0];
const flags = new Set(args.slice(1).filter((a) => a.startsWith('--')));
const flagVals = Object.fromEntries(
  args.slice(1).filter((a) => /^--[a-z-]+=/.test(a)).map((a) => [a.slice(2, a.indexOf('=')), a.slice(a.indexOf('=') + 1)])
);
const pos = args.slice(1).filter((a) => !a.startsWith('--'));
const DRY = flags.has('--dry-run');
// os.homedir() also covers Windows (no $HOME), but throws when no home can be resolved.
// Artifacts live under keel/. openspec/ belongs to OpenSpec, a different tool; Keel never reads it.
const ARTIFACTS = 'keel';
const CHANGES = path.join(ARTIFACTS, 'changes');
const HOME = (() => { try { return require('os').homedir(); } catch (e) { return process.env.HOME || ''; } })();

function die(msg) { console.error(`sdd: ${msg}`); process.exit(1); }
function say(...m) { console.log(...m); }

const MANIFEST = JSON.parse(fs.readFileSync(path.join(ROOT, 'build', 'manifest.json'), 'utf8'));
const REGISTRY = MANIFEST.registry;
const SHARED = MANIFEST.sharedSkillsDir;
const AGENT_IDS = Object.keys(REGISTRY);
const expand = (p) => (p.startsWith('~') ? path.join(HOME, p.slice(1)) : p);
const fill = (tpl, name) => tpl.replace(/\{name\}/g, () => name).replace(/\{short\}/g, () => name.replace(/^sdd-/, ''));
// Managed blocks are wrapped in `keel:begin/end agent=<id>` markers. The scanner is strict:
// blocks must not nest, ends must match their begin, and each agent may own one block per
// file. Anything else is MALFORMED and install refuses to touch the file.
// The legacy generic block (no end marker) is unmanaged: doctor reports it, nothing edits it.
const LEGACY_GENERIC_BLOCK = /<!-- sdd-kit generic block v\d+ -->/;
const MARKER = /<!-- keel:(begin|end) agent=([a-z0-9-]+) -->/g;
const lineOf = (text, index) => text.slice(0, index).split('\n').length;

function scanBlocks(text) {
  const blocks = [];
  let open = null;
  const seen = new Map();
  for (const m of text.matchAll(MARKER)) {
    const [tok, kind, id] = m;
    const line = lineOf(text, m.index);
    if (kind === 'begin') {
      if (open) return { error: `line ${line}: begin marker for agent=${id} while the block for agent=${open.id} (line ${open.line}) has no end marker` };
      if (seen.has(id)) return { error: `line ${line}: second block for agent=${id} (the first is at line ${seen.get(id)})` };
      open = { id, line, start: m.index };
      seen.set(id, line);
    } else {
      if (!open) return { error: `line ${line}: end marker for agent=${id} without a begin marker` };
      if (open.id !== id) return { error: `line ${line}: end marker for agent=${id} closes the block for agent=${open.id} that began at line ${open.line}` };
      let end = m.index + tok.length;
      const nl = /^\r?\n/.exec(text.slice(end));
      if (nl) end += nl[0].length;
      blocks.push({ id, start: open.start, end });
      open = null;
    }
  }
  if (open) return { error: `line ${open.line}: begin marker for agent=${open.id} has no end marker` };
  return { blocks };
}

const eolOf = (text) => {
  const crlf = (text.match(/\r\n/g) || []).length;
  const lf = (text.match(/\n/g) || []).length - crlf;
  return crlf > lf ? '\r\n' : '\n';
};
const hasBlock = (text, id) => { const r = scanBlocks(text); return Boolean(r.blocks && r.blocks.some((b) => b.id === id)); };
const readersOf = (dir) => AGENT_IDS.filter((a) => (REGISTRY[a].skillsRead || []).includes(dir));

function safeContextFile(name) {
  if (!name) die('--context-file needs a file name');
  if (path.isAbsolute(name) || /^[a-zA-Z]:/.test(name)) die('--context-file must be a relative path inside the project');
  if (name.split(/[\\/]+/).includes('..')) die('--context-file must not contain ".."');
  const cwd = fs.realpathSync(process.cwd());
  const target = path.resolve(cwd, name);
  const inside = (p) => p === cwd || p.startsWith(cwd + path.sep);
  if (!inside(target)) die('--context-file resolves outside the project');
  let probe = target;
  while (!fs.existsSync(probe) && probe !== cwd) probe = path.dirname(probe);
  if (fs.existsSync(probe) && !inside(fs.realpathSync(probe))) die('--context-file resolves outside the project (symlink)');
  return target;
}

// Read-only scan of project context files for blocks sdd did not write with managed markers.
function contextFilesToScan() {
  const files = new Set(['AGENTS.md']);
  for (const id of AGENT_IDS) {
    const f = REGISTRY[id].install.contextFile && REGISTRY[id].install.contextFile.project;
    if (f) files.add(f);
  }
  return [...files];
}

function legacyFindings() {
  const out = [];
  for (const f of contextFilesToScan()) {
    if (!fs.existsSync(f)) continue;
    const text = fs.readFileSync(f, 'utf8');
    const m = LEGACY_GENERIC_BLOCK.exec(text);
    if (m) {
      out.push(`notice: ${f}:${lineOf(text, m.index)} holds a legacy generic block (${m[0]}) with no end marker. It is unmanaged: ` +
        'sdd install appends a managed block and leaves this one untouched, and doctor never edits files. ' +
        'To clean up by hand, delete the legacy block yourself.');
    }
    const scan = scanBlocks(text);
    if (scan.error) out.push(`error: ${f}: malformed keel block markers — ${scan.error}. sdd install refuses to modify this file until it is fixed by hand.`);
  }
  return out;
}

// User-level skills dirs an agent may read: its own install target plus the shared dirs it reads
// under $HOME. The home-relative layout of the shared dirs mirrors the project one (unverified).
function userSkillDirs(id) {
  const r = REGISTRY[id];
  const u = r.install.user;
  const own = ((u && u.map) || []).filter((m) => m.from === 'skills').map((m) => path.join(expand(u.root), m.to));
  return [...new Set([...own, ...(r.skillsRead || []).map((d) => path.join(HOME, d))])];
}

function unverifiedNote(id) {
  const r = REGISTRY[id];
  const fields = r.unverifiedFields || [];
  if (r.status === 'verified' && !fields.length) return null;
  const head = r.status === 'experimental' ? 'EXPERIMENTAL' : 'partially verified against docs';
  return `warning: ${r.displayName} is ${head}${fields.length ? ` — unverified: ${fields.join(', ')}` : ''}\n  ${r.notes}`;
}

const PHASES = [
  ['explore', 'exploration.md'],
  ['proposal', 'proposal.md'],
  ['spec', 'specs'],
  ['clarify', 'clarifications.md'],
  ['design', 'design.md'],
  ['blast-radius', 'blast-radius.md'],
  ['tasks', 'tasks.md'],
];
// phase label → core/phases filename (generic mode reads these)
const PHASE_FILE = {
  explore: 'sdd-explore', proposal: 'sdd-propose', spec: 'sdd-spec', clarify: 'sdd-clarify',
  design: 'sdd-design', 'blast-radius': 'sdd-blast-radius', tasks: 'sdd-tasks',
  apply: 'sdd-apply', verify: 'sdd-verify', archive: 'sdd-archive',
};

function taskCounts(dir) {
  const f = path.join(dir, 'tasks.md');
  if (!fs.existsSync(f)) return null;
  const t = fs.readFileSync(f, 'utf8');
  const done = (t.match(/^[ \t]*- \[x\]/gmi) || []).length;
  const pending = (t.match(/^[ \t]*- \[ \]/gmi) || []).length;
  return { done, pending };
}

function stateOf(dir) {
  const f = path.join(dir, 'state.yaml');
  if (!fs.existsSync(f)) return {};
  const out = {};
  for (const line of fs.readFileSync(f, 'utf8').split('\n')) {
    const m = line.match(/^([a-z_]+):\s*(.*)$/);
    if (m) out[m[1]] = m[2].trim();
  }
  return out;
}

// Keel before 0.4.0 wrote to openspec/. Its config names an artifact_store; OpenSpec's does not.
function legacyArtifactDir() {
  try { return /^artifact_store:/m.test(fs.readFileSync(path.join('openspec', 'config.yaml'), 'utf8')); } catch (e) { return false; }
}
const LEGACY_HINT = 'openspec/ holds Keel artifacts from before 0.4.0 — move them: git mv openspec keel, ' +
  'then set artifact_store: files (formerly openspec) in keel/config.yaml.';

function activeChanges() {
  const base = CHANGES;
  if (!fs.existsSync(base)) return [];
  return fs.readdirSync(base, { withFileTypes: true })
    .filter((d) => d.isDirectory() && d.name !== 'archive')
    .filter((d) => stateOf(path.join(base, d.name)).status !== 'archived')
    .map((d) => d.name);
}

function progress(dir) {
  const done = PHASES.filter(([, f]) => fs.existsSync(path.join(dir, f))).map(([p]) => p);
  if (done.length === PHASES.length) {
    const t = taskCounts(dir);
    if (t && t.pending === 0 && t.done > 0) done.push('apply');
    if (fs.existsSync(path.join(dir, 'verify-report.md'))) done.push('verify');
  }
  return done;
}

function guardDecision(dir) {
  const f = path.join(dir, 'tasks.md');
  if (!fs.existsSync(f)) return '-';
  const t = fs.readFileSync(f, 'utf8');
  const m = t.match(/^Decision needed before apply: (\w+)/m);
  if (!m) return '-';
  if (m[1] === 'No') return 'none';
  return /Chain strategy: (?!pending)/.test(t) ? 'resolved' : 'PENDING';
}

function hasSddEntry(dir) {
  try { return fs.readdirSync(dir).some((n) => n.startsWith('sdd')); } catch (e) { return false; }
}

// The shared skills dir says nothing about WHICH agent was installed (skills are written once
// for every reader), so "installed" means an agent-specific artifact: its own non-shared dirs
// or its per-agent context-file block.
function installedInProject(id) {
  const r = REGISTRY[id];
  if (r.install.method === 'plugin') return r.projectMarkers.some((p) => fs.existsSync(p));
  if (r.install.method === 'floor') return fs.existsSync(path.join('.sdd', 'core'));
  const proj = r.install.project;
  const own = ((proj && proj.map) || []).map((m) => m.to).filter((d) => d !== SHARED);
  if (own.some((d) => hasSddEntry(path.join(proj.root, d)))) return true;
  const cf = r.install.contextFile && r.install.contextFile.project;
  return Boolean(cf && fs.existsSync(cf) && hasBlock(fs.readFileSync(cf, 'utf8'), id));
}

function dialect() {
  const has = (p) => fs.existsSync(p);
  if (has('.claude') || has('CLAUDE.md')) return { name: 'claude', next: fill(REGISTRY.claude.invoke.cmd, 'continue') };
  for (const id of AGENT_IDS) {
    if (id === 'claude' || id === 'generic') continue;
    if (installedInProject(id)) return { name: id, next: fill(REGISTRY[id].invoke.cmd, 'continue') };
  }
  if (has('.sdd') || has('AGENTS.md')) return { name: 'generic', next: 'read .sdd/core/phases/<next-phase>.md (single-phase mode)' };
  return { name: 'none', next: fill(REGISTRY.claude.invoke.cmd, 'continue'), hint: '  (no adapter detected in this repo yet — sdd install <tool>)' };
}

// Refuse (before anything is written) to work with a context file whose markers are malformed.
function assertMarkersSane(file) {
  if (!fs.existsSync(file)) return;
  const scan = scanBlocks(fs.readFileSync(file, 'utf8'));
  if (scan.error) {
    console.error(`sdd: ${file}: malformed keel block markers — ${scan.error}.\n  Fix or delete the stray marker(s) by hand, then re-run. Nothing was written.`);
    process.exit(1);
  }
}

// Each agent owns one marked region; re-runs replace only that region and never touch
// user content outside the markers, so codex and kimi can share one AGENTS.md.
// A malformed file aborts the install before anything is written.
function upsertBlock(file, blockPath, id) {
  const existing = fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : '';
  assertMarkersSane(file);
  const scan = scanBlocks(existing);
  const eol = eolOf(existing);
  const block = fs.readFileSync(blockPath, 'utf8').replace(/\r?\n/g, eol);
  const cur = scan.blocks.find((b) => b.id === id);
  if (cur) {
    const next = existing.slice(0, cur.start) + block + existing.slice(cur.end);
    if (next === existing) { say(`${file}: ${id} block already up to date.`); return; }
    if (DRY) { say(`  would replace the ${id} block in ${file}`); return; }
    fs.writeFileSync(file, next);
    say(`${id} block updated → ${file}`);
    return;
  }
  if (DRY) { say(`  would append the ${id} block to ${file}`); return; }
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.appendFileSync(file, (existing ? (existing.endsWith('\n') ? eol : eol + eol) : '') + block);
  say(`${id} block appended → ${file}`);
}

function installAgent(id, scope) {
  const r = REGISTRY[id];
  const note = unverifiedNote(id);
  if (note) say(note + '\n');
  const src = path.join(ROOT, 'adapters', id);

  if (r.install.method === 'plugin') {
    say(`${r.displayName} installs plugins from the marketplace — run inside it:`);
    for (const c of r.install.pluginCommands) say(`  ${c}`);
    say('local testing from this clone instead: /plugin marketplace add <path-to-keel>');
    return;
  }

  if (r.install.method === 'floor') {
    if (scope === 'user') die('generic install is per-project (--project)');
    const cwd = process.cwd();
    const extra = flagVals['context-file'] !== undefined ? safeContextFile(flagVals['context-file']) : null;
    assertMarkersSane(path.join(cwd, 'AGENTS.md'));
    if (extra) assertMarkersSane(extra);
    const n = copyTree(path.join(src, 'core'), path.join(cwd, '.sdd', 'core'));
    const block = path.join(src, 'AGENTS.block.md');
    upsertBlock(path.join(cwd, 'AGENTS.md'), block, id);
    if (extra) upsertBlock(extra, block, id);
    say(`generic: ${DRY ? 'would install' : 'installed'} ${n} core files → .sdd/core/ + context file binding`);
    return DRY ? say('  would install the commit guard') : runGuard('install');
  }

  if (!scope) die(`${id} needs --user or --project`);
  const target = r.install[scope];
  if (!target) die(`${id} has no ${scope} install target`);
  const base = scope === 'user' ? expand(target.root) : path.join(process.cwd(), target.root);
  const ctxDest = r.emit.contextFile && r.install.contextFile && r.install.contextFile[scope];
  if (ctxDest) assertMarkersSane(scope === 'user' ? expand(ctxDest) : path.join(process.cwd(), ctxDest));
  let total = 0;
  for (const m of target.map) total += copyTree(path.join(src, m.from), path.join(base, m.to));
  say(`${id} (${scope}): ${DRY ? 'would install' : 'installed'} ${total} files → ${base}`);
  say(DRY ? 'note: dry run — nothing was written.' : 'note: existing same-named files were overwritten; others untouched.');
  skillsDirNotices(id, target, base);

  const cf = r.emit.contextFile;
  if (cf) {
    const blockPath = path.join(src, cf.blockFile);
    const dest = r.install.contextFile && r.install.contextFile[scope];
    if (dest) upsertBlock(scope === 'user' ? expand(dest) : path.join(process.cwd(), dest), blockPath, id);
    else say(`no verified ${scope}-level ${cf.name} path for ${r.displayName} — append ${blockPath} to your ${cf.name} manually.`);
  }
  if (cf && !r.hooks && scope === 'project' && hooksDir()) {
    say(`${r.displayName} has no native commit hook — ${DRY ? 'would install' : 'installing'} the universal git guard.`);
    if (!DRY) runGuard('install');
  }
}

// Skills are installed once, in the shared dir, with invocation-neutral bodies. The only real
// double-discovery left is a stale copy from an older install, so warn about exactly that.
function skillsDirNotices(id, target, base) {
  const r = REGISTRY[id];
  const dests = target.map.map((m) => m.to);
  if (dests.includes(SHARED)) {
    const others = readersOf(SHARED).filter((a) => a !== id);
    say(`notice: skills are installed once in ${SHARED}${others.length ? ` (shared with ${others.join(', ')})` : ''}. ` +
      `They are invocation-neutral; ${r.displayName}-specific syntax lives only in its own context-file block or native files.`);
  }
  for (const d of r.skillsRead || []) {
    if (dests.includes(d) || !hasSddEntry(path.join(base, d))) continue;
    say(`warning: ${r.displayName} also reads ${d}, which still holds sdd skills (likely from an earlier install) — ` +
      `they would be discovered twice. Remove the sdd* entries from ${d}; sdd never deletes your files.`);
  }
}

function copyTree(src, dst) {
  if (!fs.existsSync(src)) die(`missing ${src} — run: sdd build`);
  let n = 0;
  const walk = (s, d) => {
    if (!DRY) fs.mkdirSync(d, { recursive: true });
    for (const e of fs.readdirSync(s, { withFileTypes: true })) {
      const sp = path.join(s, e.name), dp = path.join(d, e.name);
      if (e.isDirectory()) walk(sp, dp);
      else {
        if (DRY) say(`  would copy ${dp}`);
        else fs.copyFileSync(sp, dp);
        n++;
      }
    }
  };
  walk(src, dst);
  return n;
}

function main() {
  switch (cmd) {
    case 'build':
      cp.execFileSync(process.execPath, [path.join(ROOT, 'build', 'generate.js')], { stdio: 'inherit' });
      return;

    case 'install': {
      const tool = pos[0];
      const scope = flags.has('--project') ? 'project' : flags.has('--user') ? 'user' : null;
      if (!tool) die(`usage: sdd install <${AGENT_IDS.join('|')}> [--user|--project] [--dry-run]`);
      if (!REGISTRY[tool]) die(`unknown tool "${tool}" — ${AGENT_IDS.join(' | ')}`);
      return installAgent(tool, scope);
    }

    case 'status': {
      if (legacyArtifactDir()) say(`notice: ${LEGACY_HINT}\n`);
      const only = pos[0];
      let changes = activeChanges();
      if (only) changes = changes.filter((c) => c === only);
      if (!changes.length) { say(`No active changes (${ARTIFACTS}/changes/).`); return; }
      const rows = changes.map((c) => {
        const dir = path.join(CHANGES, c);
        const t = taskCounts(dir);
        return {
          change: c,
          phases: progress(dir).join('→') || '(empty)',
          tasks: t ? `${t.done}/${t.done + t.pending}` : '-',
          guard: guardDecision(dir),
          state: stateOf(dir).current_phase || '-',
        };
      });
      const w = Math.max(6, ...rows.map((r) => r.change.length));
      const pw = Math.max(6, ...rows.map((r) => r.phases.length));
      say('CHANGE'.padEnd(w), 'PHASES'.padEnd(pw), 'TASKS', 'GUARD   ', 'STATE');
      for (const r of rows)
        say(r.change.padEnd(w), r.phases.padEnd(pw), r.tasks.padEnd(5), r.guard.padEnd(8), r.state);
      say(`\nnext: ${dialect().next}${rows.some((r) => r.guard === 'PENDING') ? '  ⚠ a change needs a workload decision first' : ''}`);
      return;
    }

    case 'next': {
      const changes = activeChanges();
      if (!changes.length) { const d = dialect(); die(`no active changes — start one: ${d.name === 'generic' ? 'follow .sdd/core/commands/new.md' : fill(REGISTRY[d.name === 'none' ? 'claude' : d.name].invoke.cmd, 'new')} <change-name>`); }
      const pick = pos[0] ? changes.filter((c) => c === pos[0]) : changes;
      for (const c of pick) {
        const dir = path.join(CHANGES, c);
        const done = progress(dir);
        // explore is optional once anything after it exists
        const missing = PHASES.filter(([p]) => !done.includes(p))
          .filter(([p]) => !(p === 'explore' && done.some((d) => d !== 'explore')));
        const nxt = missing[0];
        let target;
        if (nxt) target = nxt[1] === 'specs' ? 'spec' : nxt[0];
        else if (!done.includes('apply')) target = 'apply';
        else if (!done.includes('verify')) target = 'verify';
        else if (!fs.existsSync(path.join(dir, 'verify-report.md'))) target = 'verify';
        else target = 'archive';
        const d = dialect();
        const guard = guardDecision(dir);
        if (target === 'apply' && guard === 'PENDING')
          say(`${c}: workload decision pending — resolve it (chained PRs vs size:exception) BEFORE apply.`);
        say(d.name === 'generic'
          ? `${c}: next phase = ${target} → read .sdd/core/phases/${PHASE_FILE[target]}.md (single-phase mode)`
          : `${c}: next phase = ${target} → run ${d.next} ${c}${d.hint || ''}`);
      }
      return;
    }

    case 'doctor': {
      say('agents (from build/manifest.json registry):');
      const idw = Math.max(...AGENT_IDS.map((i) => i.length));
      const warnings = [];
      for (const id of AGENT_IDS) {
        const r = REGISTRY[id];
        const found = r.detect.length ? r.detect.some((p) => fs.existsSync(expand(p))) : null;
        const inProject = installedInProject(id);
        const seen = (r.skillsRead || []).filter((d) => hasSddEntry(d));
        const cf = r.emit.contextFile;
        let ctx = '';
        if (cf) {
          const f = r.install.contextFile && r.install.contextFile.project;
          const has = f && fs.existsSync(f) && hasBlock(fs.readFileSync(f, 'utf8'), id);
          ctx = ` · ${cf.name}: ${has ? 'block present' : inProject ? 'block MISSING' : '—'}`;
        }
        const via = seen.length ? ` · skills in ${seen.join(', ')}` : '';
        say(`  ${id.padEnd(idw)} ${r.status.padEnd(13)} tool ${found === null ? 'n/a' : found ? 'found' : '—'} · project ${inProject ? 'installed' : '—'}${via}${ctx}`);
        const note = unverifiedNote(id);
        if (note && (found || inProject)) warnings.push(note);
        const seenUser = HOME ? userSkillDirs(id).filter((d) => hasSddEntry(d)) : [];
        if (seenUser.length > 1 && found)
          warnings.push(`warning: ${r.displayName} may discover the sdd skills twice at user level — they exist in ${seenUser.join(' and ')}. ` +
            'Keep one copy and remove the sdd* entries from the other; sdd never deletes your files.');
        if (seen.length > 1 && (found || inProject))
          warnings.push(`warning: ${r.displayName} would discover the sdd skills twice — they exist in ${seen.join(' and ')}. ` +
            `Skills now live once in ${SHARED}; an older install probably left the other copy. Remove the sdd* entries from the extra dir.`);
      }
      warnings.push(...legacyFindings());
      for (const w of warnings) say(`\n${w}`);
      say(`\nproject: ${process.cwd()}`);
      say(`  keel/                ${fs.existsSync(ARTIFACTS) ? 'yes' : legacyArtifactDir() ? 'NO — migrate openspec/ first (see notice), do not run init' : 'NO — run /sdd:init'}`);
      if (legacyArtifactDir()) say(`  notice               ${LEGACY_HINT}`);
      else if (fs.existsSync('openspec')) say('  openspec/            not Keel\'s (OpenSpec uses it) — ignored');
      say(`  active changes       ${activeChanges().length}`);
      try {
        const cfg = fs.readFileSync(path.join(ARTIFACTS, 'config.yaml'), 'utf8');
        const m = cfg.match(/^artifact_store:\s*["']?([^\s"'#]+)/m);
        if (m) {
          const dirs = [path.join(__dirname, '..', 'core', 'persistence'), path.join('.sdd', 'core', 'persistence')];
          const known = (n) => ['none', 'files', 'sqlite', 'mcp-generic'].includes(n)
            || dirs.some((d) => fs.existsSync(path.join(d, `${n}.md`)));
          const bad = m[1].split('+').filter((n) => !known(n));
          say(bad.length
            ? `  artifact_store       unknown artifact_store value "${bad.join('+')}" — ${bad.includes('openspec') ? 'the openspec backend is now called files' : 'map your memory server with the mcp-generic backend, see core/persistence/template.md'}`
            : `  artifact_store       ${m[1]}`);
          if (!bad.length) for (const n of m[1].split('+')) say(`  round-trip ${n.padEnd(11)}${probeBackend(n)}`);
        }
      } catch (e) { /* no config yet */ }
      const hdir = hooksDir();
      const hook = hdir && path.join(hdir, 'pre-commit');
      const text = hook && fs.existsSync(hook) ? fs.readFileSync(hook, 'utf8') : '';
      const ver = ownsHook(text) ? guardVersion(text) : 0;
      const where = hook ? path.relative(process.cwd(), hook) : '';
      say(`  commit guard         ${!hdir ? 'n/a — not a git repository'
        : !ver ? 'NOT installed — sdd guard install'
        : ver < currentGuardVersion() ? `OUTDATED (v${ver}, ${where}) — it may not check keel/; run sdd guard install`
        : `installed (${where})`}`);
      say(`  dialect in use       ${dialect().name}`);
      return;
    }

    case 'guard':
      if (DRY) return say(`would ${pos[0] || 'install'} the commit guard — dry run, nothing was written.`);
      return runGuard(pos[0] || 'install');

    case undefined:
    case 'help':
      say(`Keel (sdd) — Spec-Driven Development for any coding agent

  sdd build                          regenerate adapters/ from core/
  sdd install <agent> [--user|--project] [--dry-run]
      agents: ${AGENT_IDS.join(' | ')}  (defined in build/manifest.json)
      claude prints the marketplace commands; generic = .sdd/core/ + AGENTS.md
      + commit guard (--context-file=GEMINI.md adds a second context file)
  sdd status [change]                pipeline state of active changes (no tokens)
  sdd next [change]                  next phase + exact command for this repo
  sdd doctor                         agents (verified/experimental), keel/, backend
                                     round-trip, guards
  sdd guard install|remove           universal git pre-commit guard`);
      return;

    default:
      die(`unknown command "${cmd}" — sdd help`);
  }
}

function probeBackend(name) {
  const token = `sdd-probe-${process.pid}-${Date.now()}`;
  if (name === 'none') return 'nothing persisted (inline only)';
  if (name === 'files') {
    if (!fs.existsSync(ARTIFACTS)) return `skipped — ${ARTIFACTS}/ not found`;
    const f = path.join(ARTIFACTS, '.sdd-doctor-probe');
    try {
      fs.writeFileSync(f, token);
      return fs.readFileSync(f, 'utf8') === token ? 'SAVE→LOAD ok' : 'FAILED — read back a different value';
    } catch (e) { return `FAILED — ${e.message}`; }
    finally { fs.rmSync(f, { force: true }); }
  }
  if (name === 'sqlite') {
    const db = path.join(require('os').tmpdir(), `${token}.db`);
    try {
      const out = cp.execFileSync('sqlite3', [db, `create table t(k text primary key, v text); insert into t values('k','${token}'); select v from t where k='k';`], { encoding: 'utf8' });
      return out.trim() === token ? 'SAVE→LOAD ok (scratch db)' : 'FAILED — read back a different value';
    } catch (e) { return e.code === 'ENOENT' ? 'skipped — sqlite3 CLI not found' : `FAILED — ${e.message.split('\n')[0]}`; }
    finally { fs.rmSync(db, { force: true }); }
  }
  return 'cannot be verified offline — ask your agent to SAVE then LOAD a test key';
}

const GUARD_MARKER = /^# keel commit guard v\d+$/m;
const ownsHook = (text) => GUARD_MARKER.test(text);
const guardVersion = (text) => Number((text.match(/^# keel commit guard v(\d+)$/m) || [])[1] || 0);
// An older guard may still check openspec/ and let every keel/ commit through.
const currentGuardVersion = () => guardVersion(fs.readFileSync(path.join(ROOT, 'hooks', 'pre-commit'), 'utf8'));
const CHAINED = 'pre-commit.keel-chained';
// v2 inlined the user's original hook into the guard; v3 keeps it as its own file.
const LEGACY_CHAIN = /# --- chained original pre-commit ---\r?\n([\s\S]*?)\r?\n# --- end chain ---/;

// Where git actually runs hooks: honors core.hooksPath, worktrees, submodules and subdirs.
function hooksDir() {
  try {
    const out = cp.execFileSync('git', ['rev-parse', '--git-path', 'hooks'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
    return path.resolve(process.cwd(), out.trim());
  } catch (e) { return null; }
}

function hooksPathNotice() {
  let configured = '';
  try { configured = cp.execFileSync('git', ['config', 'core.hooksPath'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim(); } catch (e) { /* unset */ }
  if (!configured) return;
  let top = process.cwd();
  try { top = cp.execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim(); } catch (e) { /* bare repo */ }
  const at = (f) => fs.existsSync(path.join(top, f));
  const manager = at('.husky') ? 'husky' : ['lefthook.yml', '.lefthook.yml', 'lefthook.yaml'].some(at) ? 'lefthook' : null;
  say(`notice: core.hooksPath is set (${configured}), so the guard was installed there.` +
    (manager ? ` ${manager} may regenerate that directory; if the guard disappears, re-run sdd guard install.` : ''));
}

function runGuard(action) {
  const dir = hooksDir();
  if (!dir) die('not a git repository');
  const target = path.join(dir, 'pre-commit');
  const chained = path.join(dir, CHAINED);
  const rel = path.relative(process.cwd(), target) || target;
  const cur = fs.existsSync(target) ? fs.readFileSync(target, 'utf8') : null;

  if (action === 'remove') {
    if (cur === null || !ownsHook(cur)) return say(`no Keel guard found at ${rel}`);
    const legacy = cur.match(LEGACY_CHAIN);
    if (fs.existsSync(chained)) {
      fs.renameSync(chained, target);
      say('commit guard removed — original pre-commit restored.');
    } else if (legacy) {
      fs.writeFileSync(target, '#!/bin/sh\n' + legacy[1] + '\n');
      fs.chmodSync(target, 0o755);
      say('commit guard removed — original chained pre-commit restored.');
    } else { fs.rmSync(target); say('commit guard removed.'); }
    return;
  }
  if (action !== 'install') die(`unknown guard action "${action}" — install | remove`);

  // A CRLF checkout of hooks/pre-commit would break sh ("exit 0\r").
  const template = fs.readFileSync(path.join(ROOT, 'hooks', 'pre-commit'), 'utf8').replace(/\r\n/g, '\n');
  fs.mkdirSync(dir, { recursive: true });
  if (cur !== null && !ownsHook(cur)) {
    if (fs.existsSync(chained)) die(`${rel} is not a Keel guard and ${CHAINED} already exists — resolve by hand; nothing was written.`);
    // Keep the original hook intact (any interpreter, same mode): the guard execs it last.
    fs.renameSync(target, chained);
    say(`existing pre-commit kept as ${CHAINED} — it runs after the guard checks.`);
  } else if (cur !== null) {
    const legacy = cur.match(LEGACY_CHAIN);
    if (legacy && !fs.existsSync(chained)) {
      fs.writeFileSync(chained, '#!/bin/sh\n' + legacy[1] + '\n', { mode: 0o755 });
      say(`migrated the chained original pre-commit to ${CHAINED}.`);
    }
  }
  fs.writeFileSync(target, template, { mode: 0o755 });
  fs.chmodSync(target, 0o755);
  say(`commit guard ${cur !== null && ownsHook(cur) ? 'updated' : 'installed'} → ${rel}`);
  hooksPathNotice();
}

main();
